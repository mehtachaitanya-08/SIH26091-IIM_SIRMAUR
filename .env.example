# ==============================================================================
# ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and insert your personal API keys
# ==============================================================================

# Open Government Data (data.gov.in) API Access Key
# Register at https://data.gov.in to obtain your free individual developer key
DATA_GOV_IN_API_KEY=your_api_key_here

# Google OAuth 2.0 Client ID (Obtained from Google Cloud Console -> APIs & Services -> Credentials)
# Required for real Google Identity Services (GIS) login
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Backend REST API URL (Optional; defaults to http://127.0.0.1:8000)
VITE_API_BACKEND_URL=http://127.0.0.1:8000

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO
